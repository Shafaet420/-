    <!-- Guide screen -->
    <string name="guide_title">সিএফটি হিসাবের সূত্র ও গাইড</string>
    <string name="guide_round_title">১. গোল গাছ / গোল কাঠের সিএফটি</string>
    <string name="guide_round_formula">(বেড় ইঞ্চি × বেড় ইঞ্চি × দৈর্ঘ্য ফুট) ÷ ২৩০৪</string>
    <string name="guide_round_alt">অথবা: (বেড় ফুট × বেড় ফুট × দৈর্ঘ্য ফুট) ÷ ১৬</string>
    <string name="guide_round_desc">গাছের মাঝখানের অংশের চারদিকের মাপকে বেড় (গোলাই) বলে। যদি গোড়া ও আগা অসমান হয়, তবে মাঝামাঝি বেড় অথবা গোড়া, মাঝ ও আগার গড় বেড় নিন।</string>
    <string name="guide_round_example">উদাহরণ: বেড় ৪৮ ইঞ্চি (৪ ফুট) এবং দৈর্ঘ্য ১০ ফুট হলে সিএফটি = (৪৮ × ৪৮ × ১০) ÷ ২৩০৪ = ১০.০০ সিএফটি।</string>

    <string name="guide_sawn_title">২. কাটা / চেরাই কাঠের সিএফটি</string>
    <string name="guide_sawn_formula">(দৈর্ঘ্য ফুট × প্রস্থ ইঞ্চি × পুরুত্ব ইঞ্চি) ÷ ১৪৪</string>
    <string name="guide_sawn_alt">অথবা: দৈর্ঘ্য (ফুট) × প্রস্থ (ফুট) × পুরুত্ব (ফুট)</string>
    <string name="guide_sawn_desc">চেরাই কাঠ বা তক্তার দৈর্ঘ্য ফুট-ইঞ্চিতে এবং প্রস্থ ও পুরুত্ব ইঞ্চিতে মাপা হয়। ইঞ্চিকে ১২ দিয়ে ভাগ করে ফুটে রূপান্তর করা হয়।</string>
    <string name="guide_sawn_example">উদাহরণ: দৈর্ঘ্য ৮ ফুট, প্রস্থ ৬ ইঞ্চি ও পুরুত্ব ৩ ইঞ্চি হলে সিএফটি = (৮ × ৬ × ৩) ÷ ১৪৪ = ১.০০ সিএফটি।</string>

    <string name="guide_suta_title">৩. সুতা থেকে ইঞ্চি রূপান্তর চার্ট</string>
    <string name="guide_suta_desc">কাঠের মাপে ১ ইঞ্চি = ৮ সুতা। পুরুত্ব বা প্রস্থে সুতা থাকলে নিচের দশমিক মান ব্যবহার করুন:</string>

    <string name="guide_unit_title">৪. প্রয়োজনীয় একক রূপান্তর</string>
    <string name="guide_unit_ft_in">১ ফুট = ১২ ইঞ্চি</string>
    <string name="guide_unit_cft_cbm">১ সিএফটি (CFT) = ০.০২৮৩২ ঘনমিটার (m³)</string>
    <string name="guide_unit_cbm_cft">১ ঘনমিটার (m³) = ৩৫.৩১৪৭ সিএফটি (CFT)</string>

